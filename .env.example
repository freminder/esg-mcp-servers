# PostgreSQL with pgvector extension
POSTGRES_DSN=postgresql://esg_user:password@localhost:5432/esg_platform

# MongoDB for GridFS PDF storage
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=esg_platform

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings (optional — defaults shown)
# EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_DEVICE=auto
# MODEL_CACHE_DIR=./model_cache

# HuggingFace token (optional — for gated model downloads)
# HF_TOKEN=hf_...

# PDF verifier model paths (optional)
# PDF_VERIFIER_MODEL_PATH=./model_artifacts/Model.pkl
# PDF_VERIFIER_VECTORIZER_PATH=./model_artifacts/Vecteur.pkl
